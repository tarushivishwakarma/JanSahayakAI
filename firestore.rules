rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        (request.auth.token.email != null && request.auth.token.email == 'admin@jansahayak.in')
      );
    }

    // Applications:
    // - Create: Authenticated users can only create applications with their own userId.
    // - Read/Update/Delete: Permitted only to the application owner or authorized admins.
    // NOTE: Server-side Firebase Admin SDK calls bypass these rules;
    // backend token and role verification in FastAPI remains strictly mandatory.
    match /applications/{appId} {
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // Explicit deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
