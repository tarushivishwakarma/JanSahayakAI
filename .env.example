# JanSahayak Backend — Environment Variables
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit the actual .env file to version control.

# Firebase Admin SDK Service Account JSON path
# Download from: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Or provide the JSON content directly (for deployment platforms like Render)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Firebase Project ID
FIREBASE_PROJECT_ID=your-project-id

# Tesseract OCR executable path (only needed if not in PATH)
# Windows example: TESSERACT_PATH=C:/Program Files/Tesseract-OCR/tesseract.exe
# Linux/Mac: leave empty if tesseract is in PATH
TESSERACT_PATH=

# CORS allowed origins (comma-separated, no wildcards in production)
ALLOWED_ORIGINS=https://jansahayakai.web.app,https://jansahayakai.firebaseapp.com,http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080

# Admin email addresses (comma-separated)
# IMPORTANT: Set to your actual admin email addresses. Remove ALL example accounts before production deployment.
# Example (replace with real admin accounts): ADMIN_EMAILS=admin@yourdomain.in
ADMIN_EMAILS=

# App settings
# Set DEBUG=false in production environments
DEBUG=false
PORT=8000

# AI / LLM Configuration
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
