# JanSahayak Backend — Environment Variables
# Copy this file to .env and fill in your values

# Firebase Admin SDK Service Account JSON path
# Download from: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Or provide the JSON content directly (for deployment platforms like Render)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Firebase Project ID
FIREBASE_PROJECT_ID=jansahayakai

# Tesseract OCR executable path (only needed if not in PATH)
# Windows example: TESSERACT_PATH=C:/Program Files/Tesseract-OCR/tesseract.exe
# Linux/Mac: leave empty if tesseract is in PATH
TESSERACT_PATH=

# Frontend URL (For CORS)
FRONTEND_URL=http://localhost:5500

# LLM Configuration (Optional, for AI Assistant)
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://jansahayak.vercel.app

# Admin email addresses (comma-separated)
ADMIN_EMAILS=admin@jansahayak.in,admin@test.com

# App settings
DEBUG=true
PORT=8000
